{
    "description": "Wave 9 criteria corpus (docs/40-read-store-port-and-document.md). `listing` runs the Store API product listing route of the S1 category with `query`, `search` the product search route with the R3b search word and `query`, `criteria` the Store API criteria body through the RequestCriteriaBuilder (like S5). Placeholders: $category, $searchWord, $manufacturer0, $manufacturer1 (the S3 manufacturers), $option:<group>:<option> (options of the filterable property groups, both ordered by id).",
    "entries": [
        {"name": "listing-default", "route": "listing", "query": {}},
        {"name": "listing-name-desc", "route": "listing", "query": {"order": "name-desc"}},
        {"name": "listing-price-asc", "route": "listing", "query": {"order": "price-asc"}},
        {"name": "listing-price-desc", "route": "listing", "query": {"order": "price-desc"}},
        {"name": "listing-topseller", "route": "listing", "query": {"order": "topseller"}},
        {"name": "listing-page-2", "route": "listing", "query": {"p": 2, "limit": 24}},
        {"name": "listing-manufacturer", "route": "listing", "query": {"manufacturer": "$manufacturer0"}},
        {"name": "listing-manufacturers-two", "route": "listing", "query": {"manufacturer": "$manufacturer0|$manufacturer1"}},
        {"name": "listing-property", "route": "listing", "query": {"properties": "$option:0:0"}},
        {"name": "listing-properties-same-group", "route": "listing", "query": {"properties": "$option:1:0|$option:1:1"}},
        {"name": "listing-properties-two-groups", "route": "listing", "query": {"properties": "$option:0:0|$option:1:0"}},
        {"name": "listing-min-price", "route": "listing", "query": {"min-price": 30}},
        {"name": "listing-max-price", "route": "listing", "query": {"max-price": 50}},
        {"name": "listing-price-range", "route": "listing", "query": {"min-price": 20, "max-price": 60}},
        {"name": "listing-rating", "route": "listing", "query": {"rating": 3}},
        {"name": "listing-shipping-free", "route": "listing", "query": {"shipping-free": 1}},
        {"name": "listing-combined", "route": "listing", "query": {"manufacturer": "$manufacturer0|$manufacturer1", "properties": "$option:1:0", "min-price": 10, "order": "price-asc"}},
        {"name": "listing-no-aggregations", "route": "listing", "query": {"no-aggregations": 1, "order": "name-desc"}},
        {"name": "listing-only-aggregations", "route": "listing", "query": {"only-aggregations": 1}},
        {"name": "listing-reduce-aggregations", "route": "listing", "query": {"reduce-aggregations": 1, "manufacturer": "$manufacturer0", "properties": "$option:0:1"}},
        {"name": "search-default", "route": "search", "query": {}},
        {"name": "search-score", "route": "search", "query": {"order": "score"}},
        {"name": "search-name-asc", "route": "search", "query": {"order": "name-asc"}},
        {"name": "search-manufacturer", "route": "search", "query": {"manufacturer": "$manufacturer0"}},
        {"name": "search-price-range", "route": "search", "query": {"min-price": 20, "max-price": 80, "order": "price-asc"}},
        {"name": "criteria-stock-range", "route": "criteria", "criteria": {"filter": [{"type": "range", "field": "stock", "parameters": {"gte": 10, "lt": 500}}], "sort": [{"field": "productNumber", "order": "ASC"}], "limit": 25, "total-count-mode": 1}},
        {"name": "criteria-or-contains", "route": "criteria", "criteria": {"filter": [{"type": "multi", "operator": "or", "queries": [{"type": "contains", "field": "productNumber", "value": "10"}, {"type": "equals", "field": "manufacturerId", "value": "$manufacturer1"}]}], "sort": [{"field": "productNumber", "order": "DESC"}], "limit": 30, "total-count-mode": 1}},
        {"name": "criteria-not-manufacturer", "route": "criteria", "criteria": {"filter": [{"type": "not", "queries": [{"type": "equals", "field": "manufacturerId", "value": "$manufacturer0"}]}], "sort": [{"field": "name", "order": "ASC"}, {"field": "productNumber", "order": "ASC"}], "limit": 20, "total-count-mode": 1}},
        {"name": "criteria-main-products", "route": "criteria", "criteria": {"filter": [{"type": "equals", "field": "parentId", "value": null}, {"type": "range", "field": "childCount", "parameters": {"gt": 0}}], "sort": [{"field": "createdAt", "order": "DESC"}, {"field": "productNumber", "order": "ASC"}], "limit": 15, "total-count-mode": 1}},
        {"name": "criteria-prefix-name", "route": "criteria", "criteria": {"filter": [{"type": "prefix", "field": "name", "value": "Ho"}], "sort": [{"field": "productNumber", "order": "ASC"}], "limit": 20, "total-count-mode": 1}},
        {"name": "criteria-aggregations", "route": "criteria", "criteria": {"limit": 1, "aggregations": [{"name": "manufacturers", "type": "terms", "field": "manufacturerId", "limit": 5}, {"name": "rating", "type": "avg", "field": "ratingAverage"}, {"name": "count", "type": "count", "field": "id"}, {"name": "price", "type": "stats", "field": "price"}, {"name": "shipping", "type": "filter", "filter": [{"type": "equals", "field": "shippingFree", "value": true}], "aggregation": {"name": "shipping-count", "type": "count", "field": "id"}}]}},
        {"name": "criteria-post-filter", "route": "criteria", "criteria": {"filter": [{"type": "range", "field": "stock", "parameters": {"gte": 1}}], "post-filter": [{"type": "equalsAny", "field": "manufacturerId", "value": ["$manufacturer0", "$manufacturer1"]}], "sort": [{"field": "productNumber", "order": "ASC"}], "limit": 20, "total-count-mode": 1, "aggregations": [{"name": "manufacturers", "type": "terms", "field": "manufacturerId"}]}},
        {"name": "criteria-options", "route": "criteria", "criteria": {"filter": [{"type": "equalsAny", "field": "optionIds", "value": ["$option:1:2"]}], "sort": [{"field": "productNumber", "order": "ASC"}], "limit": 20, "total-count-mode": 1}},
        {"name": "criteria-term", "route": "criteria", "criteria": {"term": "Hotel", "limit": 10}},
        {"name": "criteria-association-field", "route": "criteria", "criteria": {"filter": [{"type": "contains", "field": "manufacturer.name", "value": "a"}], "limit": 10}}
    ]
}
