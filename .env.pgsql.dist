# Database settings for a PostgreSQL install, copy the lines you need into your .env or .env.local.
# MySQL and MariaDB installs ignore DATABASE_PLAN_CACHE.

# Connection URL. sslmode / sslrootcert in the URL win over the DATABASE_SSL_* variables.
DATABASE_URL="pgsql://shopware:shopware@127.0.0.1:5432/shopware"

# TLS, same variables as MySQL: DATABASE_SSL_CA gives sslmode=verify-full, with DATABASE_SSL_DONT_VERIFY_SERVER_CERT=1 it is sslmode=require.
#DATABASE_SSL_CA=/path/to/ca.pem
#DATABASE_SSL_CERT=/path/to/client-cert.pem
#DATABASE_SSL_KEY=/path/to/client-key.pem
#DATABASE_SSL_DONT_VERIFY_SERVER_CERT=1

# Read replicas (streaming replication, hot_standby=on), same as MySQL: reads go to a replica until the request writes.
# Reads right after a write in an earlier request can be stale by the replication lag (cart, admin read after save), same as MySQL.
#DATABASE_REPLICA_0_URL="pgsql://shopware:shopware@127.0.0.1:5433/shopware"

# Persistent connections: php-fpm keeps its backend between requests and skips the connect and the ICU collation load.
# Size max_connections of the server for php-fpm workers times web nodes, every worker keeps one backend.
# Behind a transaction mode pooler (PgBouncer >= 1.21 with max_prepared_statements > 0) set this to 0 and do not set DATABASE_PLAN_CACHE:
# the plan cache uses SQL-level PREPARE, which lives on one server connection and is gone on the next transaction.
DATABASE_PERSISTENT_CONNECTION=1

# Per-connection plan cache: repeated statements are prepared once per backend and reuse the plan.
# Needs DATABASE_PERSISTENT_CONNECTION=1, has no effect without it.
# Leave plan_cache_mode on auto on the server.
DATABASE_PLAN_CACHE=1
